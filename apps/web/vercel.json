{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "https://paperbrew-api.vercel.app/api/auth/$1" },
    { "source": "/api/(.*)", "destination": "https://paperbrew-api.vercel.app/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
