DATABASE_URL=postgres://postgres:postgres@localhost:5432/paperbrew
PORT=8787
# Where forwarded mail arrives; {token} is each user's word token (amber-otter-lantern).
# CloudMailin (current): 4fcb639be7306607cef6+{token}@cloudmailin.net
# Postmark: {token}@save.example.com (own domain) or a1b2c3+{token}@inbound.postmarkapp.com
INBOUND_ADDRESS=4fcb639be7306607cef6+{token}@cloudmailin.net
# Better Auth. The secret is at least 32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-plus-chars
# The WEB origin, not the API's. OAuth callbacks are $BETTER_AUTH_URL/api/auth/callback/{google|github|reddit}.
BETTER_AUTH_URL=http://localhost:5173
# Sign-in providers: each is enabled only when both its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Basic auth for both inbound webhooks. CloudMailin/Postmark send it from the target URL:
# https://USER:PASSWORD@api.example.com/webhooks/cloudmailin/inbound (or /webhooks/postmark/inbound)
INBOUND_WEBHOOK_USER=paperbrew
INBOUND_WEBHOOK_PASSWORD=change-me-to-a-long-random-string
# true = only accept mail from the account email or a verified alias
REQUIRE_KNOWN_SENDER=false
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5000000
# Vercel cron sends it as "Authorization: Bearer <CRON_SECRET>" to /cron/run-jobs (optional locally)
CRON_SECRET=
# Local only: the Chrome that GET /brew prints with (Vercel uses @sparticuz/chromium). Defaults to macOS Chrome.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
